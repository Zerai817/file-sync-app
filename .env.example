# PostgreSQL (Neon free tier) — required for cloud + iPhone access
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Generate a random string (32+ chars): https://generate-secret.vercel.app/32
JWT_SECRET="your-long-random-secret-here"

# Storage: "database" for cloud (Vercel), "filesystem" for local dev
STORAGE_MODE="database"

# Max upload size in MB (keep under 25 for free tier)
MAX_FILE_SIZE_MB=25
